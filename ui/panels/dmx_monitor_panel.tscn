[gd_scene format=3]

[ext_resource type="Script" path="res://ui/panels/dmx_monitor_panel.gd" id="1_01oh3"]
[ext_resource type="Script" path="res://ui/panels/dmx_overview.gd" id="2_over"]

[node name="DMXMonitorPanel" type="MarginContainer"]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16
script = ExtResource("1_01oh3")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Heading" type="VBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Row" type="HBoxContainer" parent="Column/Heading"]
layout_mode = 2

[node name="Title" type="Label" parent="Column/Heading/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionTitle"
text = "Universe 1"
uppercase = true

[node name="Rule" type="HSeparator" parent="Column/Heading"]
layout_mode = 2

[node name="Status" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
autowrap_mode = 3

[node name="Overview" type="Control" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_over")

[node name="Hint" type="Label" parent="Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
theme_type_variation = &"Caption"
text = "Hover a square to see which fixture owns it. Click to select."
autowrap_mode = 3

[node name="Problems" type="Label" parent="Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"Caption"
theme_override_colors/font_color = Color(1, 0.33, 0.41, 1)
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Cards" type="VBoxContainer" parent="Column/Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Empty" type="Label" parent="Column/Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "No fixtures yet. Add one from the Library and its channels appear here."
autowrap_mode = 3
