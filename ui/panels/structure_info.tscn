layout_mode = 2
theme_type_variation = &"TitleLabel"
text_overrun_behavior = 3

[node name="PieceDetail" type="Label" parent="Title"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Subtitle"
text_overrun_behavior = 3

[node name="NameField" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Caption" type="Label" parent="NameField"]
