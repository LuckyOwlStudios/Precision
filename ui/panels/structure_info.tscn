layout_mode = 2
theme_type_variation = &"Subtitle"
text = "Name"

[node name="PieceName" type="LineEdit" parent="NameField"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Name this piece"
select_all_on_focus = true

