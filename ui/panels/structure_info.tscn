[gd_scene format=3]

[ext_resource type="Script" path="res://ui/panels/structure_info.gd" id="1_info"]

[node name="StructureInfo" type="VBoxContainer"]
visible = false
size_flags_horizontal = 3
theme_override_constants/separation = 12
script = ExtResource("1_info")

[node name="Title" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="PieceTitle" type="Label" parent="Title"]
