toggle_mode = true
text = "Imperial"

[node name="Gap2" type="Control" parent="Background/Margin/Column"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="LanguageTitle" type="Label" parent="Background/Margin/Column"]
layout_mode = 2
